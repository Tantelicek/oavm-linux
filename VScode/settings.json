
{
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 200,
    "nix.serverPath": "nixd",
    "nix.enableLanguageServer": true,
    "nix.serverSettings": {
    "nixd": {
      "formatting": {
        "command": [ "alejandra" ], // or nixfmt or nixpkgs-fmt
      },
      "options": {
         "nixos": {
           "expr": "(builtins.getFlake \"/home/student/oavm-linux/oavm-linux/flake.nix\").nixosConfigurations.oavm-linux-d.options"
         },
         "home_manager": {
           "expr": "(builtins.getFlake \"/home/student/oavm-linux/oavm-linux/flake.nix\").homeConfigurations.oavm-linux-d.options"
         },
      },
    }
  },
  "security.workspace.trust.untrustedFiles": "open",
  "git.autofetch": true,
  "nix.formatterPath": "alejandra"
}
